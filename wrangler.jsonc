{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursegen-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "nexcourse.ai", "custom_domain": true },
    { "pattern": "www.nexcourse.ai", "custom_domain": true }
  ]
}
