node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
!.env.capacitor

# Lock file excluded so Cloudflare Pages uses npm install (not npm ci)
# which avoids Node version mismatch resolution conflicts.
# Render generates its own lock file on deploy too.
package-lock.json

# Backup files (should never be committed)
*.backup.*
*.backup

# Capacitor / native build junk (keep android/ + ios/ project sources)
android/app/build/
android/.gradle/
android/captures/
android/local.properties
ios/App/Pods/
ios/App/build/
ios/DerivedData/
*.keystore
*.jks

