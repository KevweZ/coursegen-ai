# ─────────────────────────────────────────────────────────────────────────────
# CourseGEN AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────
#
# SECURITY RULES:
#   ✅ Variables WITHOUT the VITE_ prefix are SERVER-SIDE ONLY.
#      They are loaded by server.js and NEVER sent to the browser bundle.
#
#   ❌ NEVER add VITE_ prefix to API keys or secrets.
#      VITE_ variables are inlined into the browser JavaScript at build time
#      and are fully visible to any user who opens DevTools.
#
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — required. Server startup will fail without this.
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# OpenAI API key — required for TTS (text-to-speech) audio narration.
# Also used as the fallback for AI course cover images when OPENROUTER_API_KEY is unset.
OPENAI_API_KEY="your-openai-api-key-here"

# Optional — preferred path for AI image generation (Gemini Flash Image via OpenRouter).
# If missing, /api/generate-image falls back to OpenAI DALL·E 3 using OPENAI_API_KEY.
# OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Express proxy server port (default: 3001)
PORT=3001

# Set to "production" when deploying
NODE_ENV=development

# ─── Trial User System ────────────────────────────────────────────────────────
ADMIN_SECRET="replace-with-your-fort-knox-password"
VITE_ADMIN_SECRET="replace-with-your-fort-knox-password"
VITE_API_BASE="http://localhost:3001"
# Must match the signed-in admin email for Account view switcher / invite panel
# VITE_ADMIN_EMAIL="you@example.com"

# ─── Stripe (server-side only — set on Render) ────────────────────────────────
# Default: test. Flip to live only on launch day (see docs/STRIPE_LAUNCH_CHECKLIST.md).
STRIPE_MODE=test

# Test keys (active while STRIPE_MODE=test)
# STRIPE_SECRET_KEY_TEST=sk_test_...
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# Legacy alias still works as fallback:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Live keys (store on Render early; unused until STRIPE_MODE=live)
# STRIPE_SECRET_KEY_LIVE=sk_live_...
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Prices — prefer mode-suffixed keys. Create with:
#   node stripe_create_v2_prices.mjs          # test
#   node stripe_create_v2_prices.mjs --live   # live
# STRIPE_PRICE_PRO_CREATOR_ANNUAL_TEST=price_...
# STRIPE_PRICE_PRO_CREATOR_MONTHLY_TEST=price_...
# STRIPE_PRICE_BUSINESS_TEAM_ANNUAL_TEST=price_...
# STRIPE_PRICE_PRO_CREATOR_ANNUAL_LIVE=price_...
# STRIPE_PRICE_PRO_CREATOR_MONTHLY_LIVE=price_...
# STRIPE_PRICE_BUSINESS_TEAM_ANNUAL_LIVE=price_...
# Unsuffixed fallbacks (used if mode-suffixed missing):
# STRIPE_PRICE_PRO_CREATOR_ANNUAL=price_...
# STRIPE_PRICE_PRO_CREATOR_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_TEAM_ANNUAL=price_...
# STRIPE_PRICE_CREDITS_STANDARD=price_...
# STRIPE_PRICE_CREDITS_VOLUME=price_...

# Team seats SQL (run once in Supabase):
#   supabase_drafts_migration.sql
#   supabase_workspaces_migration.sql
