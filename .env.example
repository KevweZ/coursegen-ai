# ─────────────────────────────────────────────────────────────────────────────
# CourseGEN AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────
#
# SECURITY RULES:
#   ✅ Variables WITHOUT the VITE_ prefix are SERVER-SIDE ONLY.
#      They are loaded by server.js and NEVER sent to the browser bundle.
#
#   ❌ NEVER add VITE_ prefix to API keys or secrets.
#      VITE_ variables are inlined into the browser JavaScript at build time
#      and are fully visible to any user who opens DevTools.
#
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — required. Server startup will fail without this.
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# OpenAI API key — required for TTS (text-to-speech) audio narration.
# Also used as the fallback for AI course cover images when OPENROUTER_API_KEY is unset.
OPENAI_API_KEY="your-openai-api-key-here"

# Optional — preferred path for AI image generation (Gemini Flash Image via OpenRouter).
# If missing, /api/generate-image falls back to OpenAI DALL·E 3 using OPENAI_API_KEY.
# OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Express proxy server port (default: 3001)
PORT=3001

# Set to "production" when deploying
NODE_ENV=development

# ─── Future: Auth & Database (add when backend is implemented) ────────────────
# JWT_SECRET="a-long-random-secret-string-min-32-chars"
# DATABASE_URL="postgresql://user:pass@host:5432/coursegen"
# SESSION_SECRET="another-long-random-secret"

# ─── Trial User System ────────────────────────────────────────────────────────
# A long random string used to authenticate the /api/admin/invite and
# /api/admin/revoke endpoints. Set this in Render (server) env vars.
# Generate one at: https://randomkeygen.com (Fort Knox Passwords)
ADMIN_SECRET="replace-with-your-fort-knox-password"

# VITE_ version of the same secret — used by the client-side TrialInvitePanel
# to call the admin endpoints. Must match ADMIN_SECRET exactly.
VITE_ADMIN_SECRET="replace-with-your-fort-knox-password"

# Base URL of the proxy server (used by the admin invite panel in the browser)
# Development: http://localhost:3001
# Production:  https://api.nexcourse.ai  (or wherever your server.js runs)
VITE_API_BASE="http://localhost:3001"

# ─── Stripe (server-side only — set on Render) ────────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Creator annual ($708/yr) — checkout planId: pro_creator
# STRIPE_PRICE_PRO_CREATOR_ANNUAL=price_...
# Creator monthly ($79/mo) — checkout planId: pro_creator_monthly
# STRIPE_PRICE_PRO_CREATOR_MONTHLY=price_...
# Team annual ($1,788/yr · up to 5 seats) — checkout planId: business_team
# STRIPE_PRICE_BUSINESS_TEAM_ANNUAL=price_...
# Legacy fallbacks (optional):
# STRIPE_PRICE_PRO_CREATOR=price_...
# STRIPE_PRICE_BUSINESS_TEAM=price_...
# STRIPE_PRICE_CREDITS_STANDARD=price_...
# STRIPE_PRICE_CREDITS_VOLUME=price_...
#
# Create the three v2 prices locally (writes IDs into .env):
#   node stripe_create_v2_prices.mjs
# Then copy STRIPE_PRICE_*_ANNUAL / _MONTHLY values to Render.
#
# Team seats also need the SQL migration run once in Supabase:
#   supabase_workspaces_migration.sql
